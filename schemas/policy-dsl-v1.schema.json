{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/policy-dsl-v1.schema.json",
  "title": "Lingo Legacy Rule Engine Policy DSL v1.0",
  "type": "object",
  "required": ["policy"],
  "additionalProperties": false,
  "properties": {
    "policy": {
      "type": "object",
      "required": ["id", "version", "status", "scope", "conditions", "decision", "precedence", "audit", "effective"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["DRAFT", "VALIDATING", "APPROVAL_REQUIRED", "APPROVED", "ACTIVE", "SUSPENDED", "ARCHIVED"]},
        "scope": {"type": "object", "required": ["resource", "action"], "additionalProperties": false, "properties": {"resource": {"type": "string"}, "action": {"type": "string"}, "user": {"type": ["string", "null"]}, "app": {"type": ["string", "null"]}}},
        "conditions": {"type": "object"},
        "decision": {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"enum": ["ALLOW", "DENY", "LIMIT", "REQUIRE_APPROVAL", "REQUIRE_PARENT_AUTH"]}, "parameters": {"type": ["object", "null"]}}},
        "precedence": {"type": "object", "required": ["level"], "additionalProperties": false, "properties": {"level": {"enum": ["system_safety", "legal_platform", "parent", "user", "application"]}}},
        "audit": {"type": "object", "required": ["required"], "additionalProperties": false, "properties": {"required": {"const": true}}},
        "effective": {"type": "object", "required": ["starts_at", "expires_at"], "additionalProperties": false, "properties": {"starts_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}}},
        "created_by": {"type": "string"},
        "approved_by": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "effective_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "change_reason": {"type": "string"}
      }
    }
  }
}
