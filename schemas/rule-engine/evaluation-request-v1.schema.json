{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thelingolegacy.com/schemas/rule-engine/evaluation-request-v1.schema.json",
  "title":"Lingo Legacy Rule Engine Evaluation Request v1",
  "type":"object",
  "required":["identity","resource","action","context"],
  "properties":{
    "identity":{"type":"object","required":["user_id"],"properties":{"user_id":{"type":"string"},"age_group":{"type":["string","null"]},"roles":{"type":"array","items":{"type":"string"}}}},
    "resource":{"type":"string","minLength":1},
    "action":{"type":"string","minLength":1},
    "context":{"type":"object","additionalProperties":true},
    "trace_id":{"type":["string","null"]}
  },
  "additionalProperties":false
}
